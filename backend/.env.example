# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*
LOG_LEVEL=info

# Database Configuration (PostgreSQL / Supabase)
# For Supabase: Connection pooling URL (Port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# For Supabase: Direct connection URL for migrations (Port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Authentication
JWT_ACCESS_SECRET="your-32-character-or-longer-secret-key-change-this"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="7"
